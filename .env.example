# Secret for the operator endpoints (/admin/...). Pick a long random value (openssl rand -hex 32):
# the placeholder below is not accepted as a token.
FORZA_ADMIN_TOKEN=choose-a-long-random-token

# Optional settings: remove the # to use one (docs/configuration.md has them all).
# The website accounts service's token, for players deleting their own photos and designs from
# the website (docs/operating.md, Website accounts). Not the admin token.
#FORZA_OWNER_TOKEN=choose-another-long-random-token
# The game's database, for the Horizon World's events and the Co-op Festival: copy
# media/db/gamedb.slt from your own game files into ./data first.
#FORZA_GAME_DB=/data/gamedb.slt
# The names players type to reach this server (without the port), comma separated.
#FORZA_SERVER_NAMES=your.domain.example
# Behind a tunnel (playit.gg): the tunnel agent's address, and the TCP tunnel's public port.
#FORZA_TRUSTED_PROXIES=192.168.1.10,127.0.0.0/8
#FORZA_PROXY_HTTP_PORT=12346
# The website's builder or web server, when it reaches this server from a public address (one
# on this machine or the home network needs nothing): no per-address budget for it on the
# community photos and videos (docs/configuration.md, The photo and video files).
#FORZA_WEBSITE_ADDRESSES=203.0.113.7
# Community videos: start the video converter's container with the server (video/README.md).
# Without it, the game's movie uploads are kept a day and then dropped, and no video is published.
#COMPOSE_PROFILES=videos
# The videos' own disk budget in MB (apart from FORZA_DISK_CAP_MB, so they never stop other uploads).
#FORZA_VIDEOS_CAP_MB=2048
