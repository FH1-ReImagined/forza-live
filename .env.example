# Secret for the operator endpoints (/admin/...). Pick a long random value.
FORZA_ADMIN_TOKEN=choose-a-long-random-token

# Optional settings: remove the # to use one (docs/configuration.md has them all).
# The game's database, for the Horizon World's events and the Co-op Festival: copy
# media/db/gamedb.slt from your own game files into ./data first.
#FORZA_GAME_DB=/data/gamedb.slt
# The names players type to reach this server (without the port), comma separated.
#FORZA_SERVER_NAMES=your.domain.example
# Behind a tunnel (playit.gg): the tunnel agent's address, and the TCP tunnel's public port.
#FORZA_TRUSTED_PROXIES=192.168.1.10,127.0.0.1
#FORZA_PROXY_HTTP_PORT=12346
